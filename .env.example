# Build-time values (Vite). Both are public; .env.production holds the real ones.
VITE_TURNSTILE_SITEKEY=     # Cloudflare Turnstile site key; unset uses the always-pass test key
VITE_PADDLE_TOKEN=          # Paddle client-side token: test_... (sandbox) or live_...; unset keeps the plans off sale

# Worker values: secrets via `npx wrangler secret put <NAME>`, locally in .dev.vars. PADDLE_API is a var in wrangler.jsonc.
# PADDLE_API=https://api.paddle.com           # or https://sandbox-api.paddle.com
# PADDLE_API_KEY=pdl_live_apikey_...
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...        # the notification destination's secret
# PADDLE_PRICE_PRO= / PADDLE_PRICE_TEAM= / PADDLE_PRICE_API=pri_...
# TURNSTILE_SECRET= / REPORT_PRIVATE_KEY_JWK=
