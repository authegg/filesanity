{
  "manifest_version": 3,
  "name": "FileSanity: remove metadata on upload",
  "short_name": "FileSanity",
  "version": "1.0.0",
  "description": "Removes hidden metadata (GPS, names, dates, device) from photos, videos, documents and PDFs as you upload them, in your browser.",
  "homepage_url": "https://filesanity.com/extension",
  "permissions": ["storage", "contextMenus", "downloads"],
  "host_permissions": ["https://filesanity.com/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "FileSanity", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }],
  "browser_specific_settings": { "gecko": { "id": "extension@filesanity.com", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } } }
}
