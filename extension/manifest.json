{
  "manifest_version": 3,
  "name": "FileSanity",
  "version": "1.1.0",
  "description": "Removes the metadata from a photo, document or PDF the moment you choose it for upload, on any site, inside the browser.",
  "permissions": ["storage"],
  "icons": { "192": "icons/icon-192.png", "512": "icons/icon-512.png" },
  "action": { "default_popup": "popup.html", "default_title": "FileSanity" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }],
  "browser_specific_settings": { "gecko": { "id": "extension@filesanity.com", "strict_min_version": "128.0" } }
}
